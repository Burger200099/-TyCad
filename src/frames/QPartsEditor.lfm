          OnClick = DeleteClick
        end
      end
      object lvParts: TListView
        Left = 0
        Height = 320
        Hint = 'The generic parts of this library (double click to change one)'
        Top = 36
        Width = 800
        Align = alClient
        Columns = <    
          item
