  ClientWidth = 730
  DesignTimePPI = 120
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  Position = poOwnerFormCenter
  LCLVersion = '3.0.0.3'
  object Label1: TLabel
    Left = 16
    Height = 20
    Top = 16
    Width = 85
    Caption = 'Paper family:'
  end
  object cbFamily: TComboBox
    Hint = 'The family of paper sizes'
    Left = 32
    Height = 28
    Top = 40
    Width = 200
    ItemHeight = 20
    Style = csDropDownList
