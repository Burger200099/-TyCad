      'Landscape'
      'Portrait'
    )
    OnClick = OrientChange
    TabOrder = 2
  end
  object Label3: TLabel
    Left = 512
    Height = 20
    Top = 224
    Width = 80
    Caption = 'Width (mm):'
  end
  object edWidth: TEdit
    Hint = 'The width of the page, in millimetres'
    Left = 512
    Height = 28
    Top = 248
    Width = 120
    OnChange = SizeEdited
    TabOrder = 3
    Text = 'edWidth'
  end
  object Label4: TLabel
    Left = 512
    Height = 20
    Top = 288
    Width = 85
    Caption = 'Height (mm):'
  end
  object edHeight: TEdit
    Hint = 'The height of the page, in millimetres'
    Left = 512
    Height = 28
    Top = 312
    Width = 120
