    OnClick = BrowseClick
    TabOrder = 2
  end
  object cbPrefix: TCheckBox
    Hint = 'Put the sheet number in front of each symbol reference'
    Left = 24
    Height = 24
    Top = 152
    Width = 560
    Caption = 'Prefix symbol references with sheet number'
    TabOrder = 3
  end
  object lblNote: TLabel
    Left = 24
    Height = 44
    Top = 190
    Width = 596
    AutoSize = False
    Caption = 'As in TinyCAD, the sheet-number prefix does not change the netlist (its writers no longer use it); the choice is kept.'
    WordWrap = True
  end
end
