object frmNetlist: TfrmNetlist
  Left = 1047
  Height = 330
  Top = 380
  Width = 640
  BorderIcons = [biSystemMenu]
  BorderStyle = bsSingle
  Caption = 'PCB Export'
  ClientHeight = 330
  ClientWidth = 640
  DesignTimePPI = 120
  OnCreate = FormCreate
  Position = poOwnerFormCenter
  LCLVersion = '3.0.0.3'
  object lblTitle: TLabel
    Left = 16
    Height = 20
    Top = 14
    Width = 520
    Caption = 'Export the design''s netlist for import into a PCB drawing program'
  end
  object lblFormat: TLabel
    Left = 24
    Height = 20
    Top = 58
    Width = 140
    Caption = 'Output file format:'
  end
  object cbType: TComboBox
    Hint = 'The kind of net list file to make'
    Left = 180
    Height = 28
    Top = 54
    Width = 330
    ItemHeight = 20
    Style = csDropDownList
    OnChange = TypeChange
    TabOrder = 0
  end
  object lblFile: TLabel
    Left = 24
    Height = 20
    Top = 102
    Width = 140
    Caption = 'Output file:'
  end
  object edFile: TEdit
    Hint = 'The file the net list is written to'
    Left = 180
    Height = 28
    Top = 98
    Width = 330
    TabOrder = 1
  end
  object btnBrowse: TButton
    Hint = 'Choose the file to write'
    Left = 522
    Height = 32
    Top = 96
    Width = 100
